# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Prisma (Supabase PostgreSQL)
# https://www.prisma.io/docs/reference/database-reference/connection-urls#env
# DATABASE_URL: transaction pooler (port 6543) for the app
# DIRECT_URL: session pooler (port 5432) for `pnpm db:push` / migrations
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require"
ADDRESS_ZIP_CODE_API_URL="https://brasilaberto.com/api/v2/zipcode/"
ADDRESS_ZIP_CODE_API_KEY=

CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_CLOUD_NAME=

SENDGRID_API_KEY=''
APP_URL=''

# OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# [OPTIONAL] Secret to hide the app before launch
# To be extra secure, generate the secret with the following command:
# openssl rand -hex 32
#
# APP_SECRET_KEY_LOCK=
