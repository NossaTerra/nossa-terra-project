// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// -----------------------------------------
// AUTH
//
// Lucia Auth Setup
// @link https://lucia-auth.com/database-adapters/prisma/
// -----------------------------------------

datasource db {
    provider     = "mysql"
    url          = env("DATABASE_URL")
    relationMode = "prisma"
}

generator client {
    provider = "prisma-client-js"
}

enum UserActiveState {
    active
    inactive
    inactive_payment_problem
}

enum Role {
    seller
    buyer
    backoffice
    admin
}

enum BusinessSector {
    Exporter
    Distributor
    Retailer
    Other
}

model User {
    // LUCIA AUTH
    id           String    @id @unique
    auth_session Session[]
    key          Key[]
    passwordResetTokens PasswordResetToken[]
    // END

    // ------ UserAttributes -------
    activeState UserActiveState @default(inactive)
    role        Role            @default(seller)
    name        String
    email       String          @unique

    cpf                String
    rg                 String?
    businessMainSector BusinessSector?
    // QUESTION: why do we have both fields?
    image              String?
    avatarImage        String?

    // Social Info
    phone                      String
    phoneUsesWhatsapp          Boolean
    secondaryPhone             String?
    secondaryPhoneUsesWhatsapp Boolean?
    instagram                  String?

    // Address Info
    zipCode       String
    city          String
    province      String
    street        String?
    neighborhood  String?
    streetNumber  String?
    complementary String?
    latitude      Float?
    longitude     Float?
}

model Session {
    id             String @id @unique
    user_id        String
    active_expires BigInt
    idle_expires   BigInt
    user           User   @relation(references: [id], fields: [user_id], onDelete: Cascade)

    @@index([user_id])
}

model PasswordResetToken {
    id             String @id @unique
    user_id        String
    expires        BigInt
    user           User   @relation(references: [id], fields: [user_id], onDelete: Cascade)

    @@index([user_id])
}

model Key {
    id              String  @id @unique
    hashed_password String?
    user_id         String
    user            User    @relation(references: [id], fields: [user_id], onDelete: Cascade)

    @@index([user_id])
    @@map("Key")
}

// -----------------------------------------
