// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

datasource db {
    provider     = "mysql"
    url          = env("DATABASE_URL")
    relationMode = "prisma"
}

generator client {
    provider = "prisma-client-js"
}

// -----------------------------------------
// AUTH
//
// Lucia Auth Setup
// @link https://lucia-auth.com/database-adapters/prisma/
// -----------------------------------------

enum UserActiveState {
    active
    inactive
    inactive_payment_problem
}

model User {
    id           String    @id @unique
    auth_session Session[]
    key          Key[]
    passwordResetTokens PasswordResetToken[]   // Add this line


    // UserAttributes
    email                      String          @unique
    activeState                UserActiveState @default(inactive)
    name                       String
    role                       String
    cpf                        String
    image                      String?
    rg                         String?
    zipCode                    String
    city                       String
    province                   String
    street                     String?
    neighborhood               String?
    streetNumber               String?
    complementary              String?
    phone                      String
    phoneUsesWhatsapp          Boolean?
    secondaryPhone             String?
    secondaryPhoneUsesWhatsapp Boolean?
    avatarImage                String?
    businessMainSector         String?
    instagram                  String?
    latitude                   Float?
    longitude                  Float?
}

model Session {
    id             String @id @unique
    user_id        String
    active_expires BigInt
    idle_expires   BigInt
    user           User   @relation(references: [id], fields: [user_id], onDelete: Cascade)

    @@index([user_id])
}

model PasswordResetToken {
    id             String @id @unique
    user_id        String
    expires        BigInt
    user           User   @relation(references: [id], fields: [user_id], onDelete: Cascade)

    @@index([user_id])
}

model Key {
    id              String  @id @unique
    hashed_password String?
    user_id         String
    user            User    @relation(references: [id], fields: [user_id], onDelete: Cascade)

    @@index([user_id])
    @@map("Key")
}

