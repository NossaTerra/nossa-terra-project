// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// -----------------------------------------
// AUTH
//
// Lucia Auth Setup
// @link https://lucia-auth.com/database-adapters/prisma/
// -----------------------------------------

datasource db {
    provider     = "postdgresql"
    url          = env("DATABASE_URL")
    relationMode = "prisma"
}

generator client {
    provider = "prisma-client-js"
}

enum UserActiveState {
    active
    inactive
    inactive_payment_problem
}

enum Role {
    seller
    buyer
    backoffice
    admin
}

enum BusinessSector {
    Exporter
    Roaster
    Industry
    Machinist
    Merchant
    Cooperative
    Other
}

model User {
    // LUCIA AUTH
    id                  String               @id @unique
    auth_session        Session[]
    key                 Key[]
    passwordResetTokens PasswordResetToken[]
    // END

    updatedAt DateTime @default(now()) @updatedAt

    // ------ UserAttributes -------
    activeState UserActiveState @default(inactive)
    role        Role            @default(seller)
    name        String
    email       String          @unique

    cpf                String
    rg                 String?
    businessMainSector BusinessSector?
    avatarImage        String?

    // Social Info
    phone                      String
    phoneUsesWhatsapp          Boolean
    secondaryPhone             String?
    secondaryPhoneUsesWhatsapp Boolean?
    instagram                  String?

    // Address Info
    zipCode       String
    city          String
    province      String
    street        String?
    district      String?
    streetNumber  String?
    complementary String?
    latitude      Float?
    longitude     Float?

    listings Listing[]
}

model Session {
    id             String @id @unique
    user_id        String
    active_expires BigInt
    idle_expires   BigInt
    user           User   @relation(references: [id], fields: [user_id], onDelete: Cascade)

    @@index([user_id])
}

model PasswordResetToken {
    id      String @id @unique
    user_id String
    expires BigInt
    user    User   @relation(references: [id], fields: [user_id], onDelete: Cascade)

    @@index([user_id])
}

model Key {
    id              String  @id @unique
    hashed_password String?
    user_id         String
    user            User    @relation(references: [id], fields: [user_id], onDelete: Cascade)

    @@index([user_id])
    @@map("Key")
}

enum ProductType {
    CoffeeArabica
    CoffeeRobusta
}

enum ProductCategory {
    Pronto
    MercadoInterno
    BicaCorrida
}

model Product {
    id String @id @unique @default(cuid())

    name     String
    type     ProductType
    category ProductCategory @default(Pronto)

    mainColor String
    listings  Listing[]

    updatedAt DateTime @default(now()) @updatedAt
}

model Listing {
    id String @id @unique @default(cuid())

    price Decimal

    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
    userId String

    product   Product @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)
    productId String

    updatedAt DateTime @default(now()) @updatedAt

    @@unique([userId, productId])
    @@index([userId])
    @@index([productId])
}

enum AdType {
    Banner
    Small
    Medium
}

model Ad {
    id String @id @unique @default(cuid())

    name    String
    type    AdType
    adImage String

    link     String?
    isActive Boolean
}
